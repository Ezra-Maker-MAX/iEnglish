# ============================================================
# iEnglish 环境变量
# ============================================================
#
# 这里只保留「自举依赖」——即必须先有它才能启动、才能读到后续配置的项。
# LLM 的 base_url / model / api_key 等已迁到 Turso 数据库，
# 在网页 /admin 里改，保存即生效，不用重新部署。
#

# ---------- Turso（必须，自举依赖）----------
TURSO_DATABASE_URL=libsql://ienglish-crescent.aws-ap-northeast-1.turso.io
TURSO_AUTH_TOKEN=填你的token

# ---------- 加密与签名（强烈建议配置）----------
# 用途：
#   1. 加密数据库中的 LLM API Key（AES-256-GCM）
#   2. 签发配置页的登录 Cookie（HMAC-SHA256）
#
# 生成方式（任选其一）：
#   openssl rand -hex 32
#   或随便一串足够长的随机字符
#
# 不配置也能跑，但 API Key 会以明文存进数据库，
# 且配置页顶部会持续显示告警。
SETTINGS_SECRET=

# ---------- 以下为可选兜底 ----------
# 数据库中未配置时才会用到。留空即可，推荐在 /admin 页面里配。
# LLM_BASE_URL=https://api.deepseek.com
# LLM_API_KEY=
# LLM_MODEL=deepseek-chat

DEFAULT_SCENARIO=airport-checkin
