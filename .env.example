# ============================================================
# iEnglish 本地开发环境变量
# ============================================================
#
# 这里只放「自举依赖」——必须先有它才能启动、才能读到后续配置的项。
# LLM 的 API Key / 模型 / 地址已迁到 Turso 数据库，
# 在网页 /admin 里改，保存即生效，不用重启也不用重新部署。
#

# ---------- Turso（必须）----------
TURSO_DATABASE_URL=libsql://ienglish-crescent.aws-ap-northeast-1.turso.io
TURSO_AUTH_TOKEN=填你的token

# ---------- 加密与签名（必须配同一份到 Vercel）----------
# 用途：1) 加密库中的 LLM API Key（AES-256-GCM）
#       2) 签发配置页登录 Cookie（HMAC-SHA256）
#
# ⚠️ 部署到 Vercel 时必须填同一个值，否则已保存的 Key 解不开、登录态失效。
SETTINGS_SECRET=填openssl-rand-hex-32的输出

# ---------- 可选兜底（正常不需要，推荐去 /admin 配）----------
# LLM_BASE_URL=https://api.deepseek.com
# LLM_API_KEY=
# LLM_MODEL=deepseek-chat

DEFAULT_SCENARIO=airport-checkin
